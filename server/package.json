{
  "name": "personal-knowledge-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "invite": "tsx --env-file=.env src/scripts/invite.ts",
    "reset-password": "tsx --env-file=.env src/scripts/reset-password.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
