# 服务监听端口
PORT=3001

# 单用户阶段使用的固定用户 id
DEV_USER_ID=1

# MySQL（migrate 会在库不存在时自动创建）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=personal_knowledge

# 模型服务。模型名、base URL、向量维度都在这里配置，不在代码中写死；密钥只放后端。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Embedding 使用 OpenAI 兼容接口（硅基流动）；bge-m3 实测输出 1024 维，换模型需重建索引
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

QDRANT_URL=http://127.0.0.1:6333

# 以下为可选项，不填则用默认值：每用户的限流与额度
# LIMIT_CHAT_PER_MINUTE=20
# LIMIT_AI_PER_MINUTE=10
# LIMIT_UPLOAD_PER_MINUTE=10
# LIMIT_API_PER_MINUTE=300
# 每人每天的模型 token 上限
# LIMIT_DAILY_TOKENS=200000
# 每人最多文档数、文件总容量（MB）
# LIMIT_DOCS_PER_USER=100
# LIMIT_MB_PER_USER=200
