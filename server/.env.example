# 服务监听端口
PORT=3001

# 单用户阶段使用的固定用户 id
DEV_USER_ID=1

# MySQL（migrate 会在库不存在时自动创建）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=personal_knowledge

# 模型服务。模型名、base URL、向量维度都在这里配置，不在代码中写死；密钥只放后端。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Embedding 使用 OpenAI 兼容接口（硅基流动）；bge-m3 实测输出 1024 维，换模型需重建索引
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024

QDRANT_URL=http://127.0.0.1:6333

# 检索相似度下限（0~1）：低于该分数的检索结果不会进入提示词，避免让模型拿无关资料硬凑答案。
# 0 表示不过滤。bge-m3 的分布偏高，默认 0.35 只挡掉明显无关的内容；用问答日志里的 scores
# 字段（每次实际分数）标定后再调整，常见可试范围 0.45~0.55。
# RETRIEVAL_MIN_SCORE=0.35

# 精排（rerank）：向量召回后用 cross-encoder 重新排序，决定哪些资料真正进入提示词。
# 复用上面的 EMBEDDING_BASE_URL / EMBEDDING_API_KEY（同一个硅基流动账号），不需要额外配置密钥。
# RERANK_ENABLED=true
# 影子模式：照常调用并记录分数，但最终结果仍用向量排序。用来先摸清分数分布，再定阈值
# RERANK_SHADOW=true
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 召回池：开启精排或混合检索时按 topK 的倍数放大，并有下限与上限
# RETRIEVAL_RECALL_MULTIPLIER=4
# RETRIEVAL_RECALL_FLOOR=20
# RETRIEVAL_MAX_CANDIDATES=50

# 混合检索：向量检索（语义）+ MySQL ngram 全文检索（字面），用 RRF 融合两路名次。
# 实测在语义型问题上收益不明显（23 条评估集上指标持平），主要补「型号 / 人名 / 错误码」这类字面匹配，默认关闭。
# RETRIEVAL_HYBRID=true
# RETRIEVAL_KEYWORD_LIMIT=20
# RETRIEVAL_RRF_K=60
# 精排分数阈值。rerank 分数可能是 logit（有正有负），不要用 0~1 的直觉去设；留空表示不过滤
# RERANK_MIN_SCORE=
# RERANK_TIMEOUT_MS=5000
# 开启精排时用的召回下限，比 RETRIEVAL_MIN_SCORE 更宽松，避免精排前误杀
# RETRIEVAL_RECALL_MIN_SCORE=0.2

# 以下为可选项，不填则用默认值：每用户的限流与额度
# LIMIT_CHAT_PER_MINUTE=20
# LIMIT_AI_PER_MINUTE=10
# LIMIT_UPLOAD_PER_MINUTE=10
# LIMIT_API_PER_MINUTE=300
# 每人每天的模型 token 上限
# LIMIT_DAILY_TOKENS=200000
# 每人最多文档数、文件总容量（MB）
# LIMIT_DOCS_PER_USER=100
# LIMIT_MB_PER_USER=200
